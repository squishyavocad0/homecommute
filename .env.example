# Copy to .env.local (dev) or set as environment variables on your host (e.g. Vercel → Settings → Environment Variables).
# Only the PUBLIC anon / publishable key belongs here — never the service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY
# Comma-separated housemates, exactly as in the huis_people table
VITE_HOUSEMATES=Alex,Sam,Jamie,Robin

# Set to 1 to build the self-contained demo (fake data, no Supabase at all)
# VITE_DEMO=1
